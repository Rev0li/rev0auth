# rev0auth — Caddyfile template (VPS production)
#
# Tout l'univers sous un même domaine : le portail sur la racine, chaque
# service sur un sous-domaine (AUTH-06). Les sous-domaines de
# rev0li.duckdns.org sont résolus par DuckDNS sans rien déclarer.
# Certificats par le challenge HTTP (ports 80/443 ouverts) : un certificat par
# nom, aucun jeton DuckDNS nécessaire.
#
# Required env vars (in /etc/caddy/rev0auth-caddy.env):
#   WEB_DOMAIN        e.g. rev0li.duckdns.org
#   FRONTEND_UPSTREAM e.g. 127.0.0.1:4173       (SvelteKit)
#   NAS_UPSTREAM      adresse Tailscale du NAS (SongSurf, Jellyfin, portfolio)
#   ACME_EMAIL        e.g. you@example.com

{
    email {$ACME_EMAIL:admin@example.com}
    log {
        level {$CADDY_LOG_LEVEL:INFO}
    }
}

# Le cookie de session du portail vaut pour tous les sous-domaines (AUTH-07) :
# on le retire avant de transmettre aux services, qui n'en ont pas besoin.
(sans_cookie_portail) {
    header_up Cookie "(__Secure-)?better-auth\.[A-Za-z_]+=[^;]*;?\s*" ""
}

# Porte commune (AUTH-08) : avant chaque requête, Caddy demande au portail si
# la session donne accès au service. 2xx → identité copiée dans X-User-*
# (celles envoyées par le client sont d'abord effacées) ; sinon la réponse du
# portail est renvoyée (connexion, 401 ou 403). `route` garde cet ordre :
# sans lui, Caddy exécute forward_auth avant request_header.
# Usage : `import porte_portail songsurf`
(porte_portail) {
    route {
        request_header -X-User-Id
        request_header -X-User-Name
        request_header -X-User-Role
        forward_auth {$FRONTEND_UPSTREAM:127.0.0.1:4173} {
            uri /auth/verify?service={args[0]}
            copy_headers X-User-Id X-User-Name X-User-Role
        }
    }
}

# Preuve que la requête vient de Caddy (AUTH-09) : fichier privé du VPS
# (root:caddy, 640) qui définit le snippet `preuve_songsurf` :
#   (preuve_songsurf) {
#       header_up X-Proxy-Token "<SONGSURF_PROXY_SECRET>"
#   }
# Même valeur que sur le NAS. Pas de variable d'environnement : Caddy est
# lancé avec --environ et écrirait le secret dans le journal.
import /etc/caddy/secrets/songsurf-preuve.caddy

# ── Portail (SvelteKit) ───────────────────────────────────────────────────────
{$WEB_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    handle {
        reverse_proxy {$FRONTEND_UPSTREAM:127.0.0.1:4173}
    }
}

# ── Services du NAS ───────────────────────────────────────────────────────────
songsurf.{$WEB_DOMAIN} {
    # Preflight CORS de l'extension : sans cookie, il passe sans la porte.
    # Sans preuve, le Watcher ignore toute identité ; il n'y répond que CORS.
    @preflight method OPTIONS
    handle @preflight {
        reverse_proxy {$NAS_UPSTREAM}:9000 {
            import sans_cookie_portail
            header_up -X-User-*
            header_up -X-Proxy-Token
        }
    }

    handle {
        import porte_portail songsurf
        reverse_proxy {$NAS_UPSTREAM}:9000 {
            import sans_cookie_portail
            import preuve_songsurf
        }
    }
}

jellyfin.{$WEB_DOMAIN} {
    reverse_proxy {$NAS_UPSTREAM}:8096 {
        import sans_cookie_portail
    }
}

portfolio.{$WEB_DOMAIN} {
    reverse_proxy {$NAS_UPSTREAM}:49154 {
        import sans_cookie_portail
    }
}
