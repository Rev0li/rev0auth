# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rev0auth

# SongSurf — adresse publique, derrière la porte du portail
# (e.g. https://songsurf.rev0li.duckdns.org)
SONGSURF_URL=

# BetterAuth — secret de signature des sessions (32 octets minimum)
BETTER_AUTH_SECRET=

# Port override (default: 3000 in preview, 5173 in dev)
# PORT=3000
